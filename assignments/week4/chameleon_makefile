NAME ?= sstewwart-week4-chameleon-vm
FLAVOR ?= reservation:82b76d41-98ca-496d-ad13-b48d372b7b72
IMAGE ?= CC-Ubuntu24.04
KEY ?= sstewart-wk4-key
NETWORK ?= sharednet1
SECURITY_GROUP ?= allow-ssh

help:
	@echo "Chameleon VM commands:"
	@echo "make list"
	@echo "make create"
	@echo "make info"
	@echo "make stop"
	@echo "make start"
	@echo "make delete"
	@echo "make images"
	@echo "make flavors"
	@echo "make networks"
	@echo "make keypairs"

list:
	openstack server list

create:
	openstack server create \
		--flavor $(FLAVOR) \
		--image "$(IMAGE)" \
		--key-name $(KEY) \
		--security-group $(SECURITY_GROUP) \
		--wait \
		$(NAME)

info:
	openstack server show $(NAME)

stop:
	openstack server stop $(NAME)

start:
	openstack server start $(NAME)

delete:
	openstack server delete $(NAME)

images:
	openstack image list

flavors:
	openstack flavor list

keypairs:
	openstack keypair list